{
  "rules": {
    ".read": true,
    ".write": false,

    "posts": {
  ".indexOn": ["createdAt"],

      "$postId": {
  ".write": "auth != null && root.child('users').child(auth.uid).child('isArtist').val() == true && ( !data.exists() ? newData.child('userId').val() === auth.uid : data.child('userId').val() === auth.uid )",

        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "city": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "desc": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "imageUrl": {
          ".validate": "newData.isString()"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "userId": {
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : true)"
        },

        "rsvp": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && ( !data.exists() ? newData.val() === 0 : (newData.val() >= data.val() && newData.val() <= data.val() + 1) )"
        },

        "likesCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && ( !data.exists() ? newData.val() === 0 : (newData.val() >= data.val() && newData.val() <= data.val() + 1) )"
        },

        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!data.exists() ? newData.val() === true : newData.val() === data.val())",
            ".validate": "newData.isBoolean()"
          }
        },

        "$other": {
          ".validate": false
        },

        ".validate": "newData.hasChildren(['title','date','city','desc','userId','createdAt','rsvp','likesCount'])"
      }
    }
    ,
    "profiles": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "bio": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "link": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "photoUrl": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
    ,
    "reels": {
      ".indexOn": ["createdAt"],
      "$reelId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isArtist').val() == true && ( !data.exists() ? newData.child('userId').val() === auth.uid : data.child('userId').val() === auth.uid )",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
        "desc": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "videoUrl": { ".validate": "newData.isString()" },
        "userName": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "userId": { ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)" },
        "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : true)" },
        "$other": { ".validate": false }
      }
    }
    ,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$other": { ".validate": true }
      }
    }
    ,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    }
    ,
    "artistRequests": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$other": { ".validate": true }
      }
    }
  }
}
