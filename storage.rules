rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lettura pubblica dei file statici (immagini, audio, zip): mantenuta per semplicità
    match /{allPaths=**} {
      allow read: if true;
    }

    // Scrittura consentita solo ad utenti autenticati nelle cartelle usate dall'app
    // Regole specifiche con controllo del proprietario
    match /images/{uid}/{postId}/{file=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /profiles/{uid}/{file=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /reels/{uid}/{reelId}/{file=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Legacy/cartelle statiche storiche (mantenute per compatibilità)
    match /{folder}/{rest=**} {
      allow write: if request.auth != null && (
        folder in [
          'artist-photo',
          'gallery',
          'album-cover',
          'album-video',
          'tracks',
          'album-zips',
          'buy',
          'musica',
          'site',
          'calend-arte'
        ]
      );
    }
  }
}
