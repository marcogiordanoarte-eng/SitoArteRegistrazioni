# Firebase Functions environment variables (dotenv)
# Copy this file to `.env` and fill values locally. Do NOT commit `.env`.

# Image moderation (Vision API)
VISION_API_KEY=

# Text moderation (Perspective API)
PERSPECTIVE_API_KEY=
# Optional, default 0.5 (0..1)
PERSPECTIVE_THRESHOLD=

# Optional providers (future migration)
OPENAI_API_KEY=
# SendGrid: chiave API per invio email audition / auto-reply
SENDGRID_API_KEY=YOUR_SENDGRID_KEY_HERE
# Email mittente verificata (esempio: notifiche@arteregistrazioni.it)
SITE_SENDER_EMAIL=notifiche@esempio.it
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSICKIT_TEAMID=
APPLE_MUSICKIT_KEYID=
APPLE_MUSICKIT_PRIVATEKEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
