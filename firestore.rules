rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lettura pubblica dei contenuti del sito
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Collezione artisti: lettura pubblica, scrittura admin o proprietario del profilo
    match /artisti/{docId} {
      allow read: if true;
      // Creazione completa consentita solo ad admin o proprietario
      allow create: if isAdmin() || isArtistOwner(docId);
      // Aggiornamento consentito ad admin, proprietario, oppure a qualsiasi utente autenticato
      // limitatamente ai soli campi spotifyLink e appleLink
      allow update: if isAdmin() || isArtistOwner(docId) || (
        request.auth != null &&
        resource.data.diff(request.resource.data).changedKeys().hasOnly(["spotifyLink", "appleLink"]) &&
        // Evita rimozione accidentale di altri campi obbligatori: tutti gli altri campi restano invariati
        resource.data.keys().hasAll(request.resource.data.keys())
      );
      // Eliminazione solo admin
      allow delete: if isAdmin();
    }
    match /artisti/{artistId}/tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /musicaTracks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /podcasts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Auditions: creazione pubblica controllata (no lettura pubblica), lettura solo admin
    match /auditions/{auditionId} {
      allow create: if validAudition();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    // Auditions meta (inserite da Cloud Function): solo lettura admin
    match /auditionsMeta/{metaId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /countdowns/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live plays feed: public read for visual pulses, write restricted
    match /livePlays/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CalendArte: note giorno-per-giorno visibili pubblicamente, modificabili solo admin
    match /calendArte/{monthId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Buy Music: generi e tracce
    match /buyGenres/{genreId} {
      // Le liste generi devono essere pubbliche sul sito
      allow read: if true;
      // Modifiche consentite solo agli admin
      allow write: if isAdmin();

      // Sottocollezione tracce per ogni genere
      match /tracks/{trackId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Negare qualsiasi altra operazione per default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}

function isAdmin() {
  // Consenti scrittura agli utenti con custom claim admin=true oppure a uno specifico UID
  return request.auth != null && (
    request.auth.token.admin == true ||
    request.auth.uid == 'QKWl9UFABzOOfXWwLzzmvtnnjGt1'
  );
}

function isArtistOwner(docId) {
  // Consente al creatore/proprietario (UID==docId) di aggiornare SOLO il proprio documento
  return request.auth != null && request.auth.uid == docId;
}

function validAudition() {
  return request.resource.data.keys().hasOnly([
      'name','email','linkSpotifySoundCloud','linkAppleMusic','fileUrls','createdAt'
    ]) &&
    request.resource.data.name is string &&
    request.resource.data.email is string &&
    request.resource.data.fileUrls is list &&
    request.resource.data.fileUrls.size() > 0 &&
    request.resource.data.fileUrls.size() <= 5 &&
    request.resource.data.createdAt is int;
}
